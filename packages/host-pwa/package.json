{
  "name": "@thunderclap/host-pwa",
  "version": "0.1.0",
  "type": "module",
  "description": "ThunderClap's installable web shell: a Vite plugin that emits a game's web manifest and service worker at build time, and createPwaHost(), the web Host plus install, update, offline and cache state. It knows nothing about any game and has no runtime dependencies.",
  "license": "MIT",
  "author": "ThunderClap",
  "homepage": "https://github.com/Mandalorian007/thunderclap-engine/tree/main/packages/host-pwa#readme",
  "bugs": {
    "url": "https://github.com/Mandalorian007/thunderclap-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandalorian007/thunderclap-engine.git",
    "directory": "packages/host-pwa"
  },
  "keywords": [
    "thunderclap",
    "pwa",
    "service-worker",
    "vite-plugin",
    "webgpu",
    "game-engine"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js"
  },
  "peerDependencies": {
    "@thunderclap/engine": "^1.0.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "vite build harness",
    "dev": "vite harness --host 127.0.0.1 --port 5198",
    "preview": "vite preview harness --host 127.0.0.1 --port 4551 --strictPort",
    "test:e2e": "vite build harness && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@thunderclap/engine": "workspace:*",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
