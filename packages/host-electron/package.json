{
  "name": "@thunderclap-engine/host-electron",
  "productName": "ThunderClap",
  "version": "0.1.0",
  "type": "module",
  "description": "ThunderClap's Electron host: a desktop shell (main process and preload bridge) and createElectronHost() for the renderer. It knows nothing about any game. Games depend on @thunderclap-engine/engine themselves; everything the shell runs is bundled into out/, so it has no runtime dependencies.",
  "license": "MIT",
  "author": "ThunderClap",
  "homepage": "https://github.com/Mandalorian007/thunderclap-engine/tree/main/packages/host-electron#readme",
  "bugs": {
    "url": "https://github.com/Mandalorian007/thunderclap-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandalorian007/thunderclap-engine.git",
    "directory": "packages/host-electron"
  },
  "keywords": [
    "thunderclap",
    "electron",
    "desktop",
    "webgpu",
    "game-engine"
  ],
  "sideEffects": false,
  "main": "out/main.mjs",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "out/main.mjs",
    "out/preload.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@thunderclap-engine/engine": "^1.0.0",
    "electron": ">=45.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dist": "node scripts/dist.mjs",
    "test:e2e": "node scripts/build.mjs && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@thunderclap-engine/engine": "workspace:*",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
