{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["@webgpu/types"],
    "paths": {
      "@thunderclap-engine/engine": ["../../dist/index.d.ts"],
      "@thunderclap-engine/engine/*": ["../../dist/*/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
