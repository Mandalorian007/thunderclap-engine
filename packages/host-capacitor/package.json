{
  "name": "@thunderclap-engine/host-capacitor",
  "version": "0.1.1",
  "type": "module",
  "description": "ThunderClap's Capacitor host: createCapacitorHost() fills the engine's Host interface from Capacitor's plugins for an iOS or Android store app. It knows nothing about any game and has no dependencies; @capacitor/core is an optional peer that names the Capacitor major it runs inside, and the @capacitor/* plugins are the app's own, handed in through the plugins option.",
  "license": "MIT",
  "author": "ThunderClap",
  "homepage": "https://github.com/Mandalorian007/thunderclap-engine/tree/main/packages/host-capacitor#readme",
  "bugs": {
    "url": "https://github.com/Mandalorian007/thunderclap-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandalorian007/thunderclap-engine.git",
    "directory": "packages/host-capacitor"
  },
  "keywords": [
    "thunderclap",
    "capacitor",
    "ios",
    "android",
    "webgpu",
    "game-engine"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js"
  },
  "peerDependencies": {
    "@thunderclap-engine/engine": "^1.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@capacitor/core": "^8.6.0",
    "@thunderclap-engine/engine": "workspace:*",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
