{
  "name": "@thunderclap/engine",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "ThunderClap: a WebGPU game engine for the browser. It knows nothing about any game.",
  "license": "MIT",
  "author": "ThunderClap Gaming",
  "homepage": "https://github.com/Mandalorian007/thunderclap-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandalorian007/thunderclap-engine.git"
  },
  "keywords": [
    "webgpu",
    "game-engine",
    "typescript",
    "browser",
    "2d"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./anim": "./src/anim/index.ts",
    "./assets": "./src/assets/index.ts",
    "./audio": "./src/audio/index.ts",
    "./core": "./src/core/index.ts",
    "./fx": "./src/fx/index.ts",
    "./host": "./src/host/index.ts",
    "./input": "./src/input/index.ts",
    "./platform": "./src/platform/index.ts",
    "./post": "./src/post/index.ts",
    "./render": "./src/render/index.ts",
    "./save": "./src/save/index.ts",
    "./ui": "./src/ui/index.ts",
    "./testing": "./src/render/fake-gpu.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm check:docs && pnpm test && pnpm check:host-electron && pnpm check:template-puzzle",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "release": "node scripts/release.mjs",
    "test:e2e": "playwright test",
    "harness": "vite --config vite.harness.config.ts --host 127.0.0.1",
    "example": "vite examples/hello --host 127.0.0.1",
    "check:host-electron": "pnpm --filter @thunderclap/host-electron check",
    "check:template-puzzle": "pnpm --filter @thunderclap/template-puzzle check",
    "template:puzzle": "pnpm --filter @thunderclap/template-puzzle dev",
    "desktop:dev": "pnpm --filter @thunderclap/host-electron dev",
    "desktop:build": "pnpm --filter @thunderclap/host-electron dist",
    "test:e2e:desktop": "pnpm --filter @thunderclap/host-electron test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  }
}
