{
  "name": "@thunderclap/engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ThunderClap: a WebGPU game engine for the browser. It knows nothing about any game.",
  "license": "MIT",
  "author": "ThunderClap Gaming",
  "homepage": "https://github.com/Mandalorian007/thunderclap-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandalorian007/thunderclap-engine.git"
  },
  "keywords": [
    "webgpu",
    "game-engine",
    "typescript",
    "browser",
    "2d"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./anim": "./src/anim/index.ts",
    "./assets": "./src/assets/index.ts",
    "./audio": "./src/audio/index.ts",
    "./core": "./src/core/index.ts",
    "./fx": "./src/fx/index.ts",
    "./geom": "./src/geom/index.ts",
    "./host": "./src/host/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./input": "./src/input/index.ts",
    "./nav": "./src/nav/index.ts",
    "./platform": "./src/platform/index.ts",
    "./post": "./src/post/index.ts",
    "./render": "./src/render/index.ts",
    "./save": "./src/save/index.ts",
    "./tween": "./src/tween/index.ts",
    "./ui": "./src/ui/index.ts",
    "./voxel": "./src/voxel/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm check:docs && pnpm check:snippets && pnpm check:deprecated && pnpm check:api && pnpm test && pnpm check:host-electron && pnpm check:host-capacitor && pnpm check:host-pwa && pnpm check:template-puzzle && pnpm check:template-first-person && pnpm check:template-third-person && pnpm check:template-platformer && pnpm check:create-game && pnpm check:bake",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:snippets": "node scripts/check-snippets.mjs && node --test scripts/check-snippets.test.mjs",
    "check:deprecated": "node scripts/check-deprecated.mjs && node --test scripts/check-deprecated.test.mjs scripts/check-deprecated-game.test.mjs",
    "check:api": "node scripts/api-surface.mjs && node --test scripts/api-surface.test.mjs",
    "api:update": "node scripts/api-surface.mjs --update",
    "check:create-game": "node --test scripts/create-game.test.mjs",
    "check:bake": "node --test scripts/bake.test.mjs scripts/bake-nav.test.mjs",
    "create-game": "node scripts/create-game.mjs",
    "bake": "node scripts/bake.mjs",
    "bake:nav": "node scripts/bake-nav.mjs",
    "release": "node scripts/release.mjs",
    "bench": "node scripts/bench.mjs",
    "test:e2e": "playwright test",
    "snap": "node scripts/snap.mjs --update",
    "snap:check": "node scripts/snap.mjs",
    "harness": "vite --config vite.harness.config.ts --host 127.0.0.1",
    "example": "vite examples/hello --host 127.0.0.1",
    "demo": "node scripts/demo.mjs",
    "check:host-electron": "pnpm --filter @thunderclap/host-electron check",
    "check:host-capacitor": "pnpm --filter @thunderclap/host-capacitor check",
    "check:template-puzzle": "pnpm --filter @thunderclap/template-puzzle check",
    "template:puzzle": "pnpm --filter @thunderclap/template-puzzle dev",
    "check:template-first-person": "pnpm --filter @thunderclap/template-first-person check",
    "template:first-person": "pnpm --filter @thunderclap/template-first-person dev",
    "desktop:dev": "pnpm --filter @thunderclap/host-electron dev",
    "desktop:build": "pnpm --filter @thunderclap/host-electron dist",
    "test:e2e:desktop": "pnpm --filter @thunderclap/host-electron test:e2e",
    "check:host-pwa": "pnpm --filter @thunderclap/host-pwa check",
    "pwa:dev": "pnpm --filter @thunderclap/host-pwa dev",
    "pwa:build": "pnpm --filter @thunderclap/host-pwa build",
    "check:template-third-person": "pnpm --filter @thunderclap/template-third-person check",
    "template:third-person": "pnpm --filter @thunderclap/template-third-person dev",
    "check:template-platformer": "pnpm --filter @thunderclap/template-platformer check",
    "template:platformer": "pnpm --filter @thunderclap/template-platformer dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  }
}
