{
  "name": "@thunderclap-engine/engine",
  "version": "1.2.0",
  "type": "module",
  "description": "ThunderClap: a WebGPU game engine for the browser. It knows nothing about any game.",
  "license": "MIT",
  "author": "ThunderClap Gaming",
  "homepage": "https://github.com/Mandalorian007/thunderclap-engine#readme",
  "bugs": {
    "url": "https://github.com/Mandalorian007/thunderclap-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandalorian007/thunderclap-engine.git"
  },
  "keywords": [
    "webgpu",
    "game-engine",
    "typescript",
    "browser",
    "2d",
    "3d",
    "voxel",
    "webxr",
    "gamedev"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./anim": "./src/anim/index.ts",
    "./assets": "./src/assets/index.ts",
    "./audio": "./src/audio/index.ts",
    "./core": "./src/core/index.ts",
    "./fx": "./src/fx/index.ts",
    "./geom": "./src/geom/index.ts",
    "./host": "./src/host/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./input": "./src/input/index.ts",
    "./nav": "./src/nav/index.ts",
    "./platform": "./src/platform/index.ts",
    "./post": "./src/post/index.ts",
    "./render": "./src/render/index.ts",
    "./save": "./src/save/index.ts",
    "./tween": "./src/tween/index.ts",
    "./ui": "./src/ui/index.ts",
    "./voxel": "./src/voxel/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./analytics": {
        "types": "./dist/analytics/index.d.ts",
        "import": "./dist/analytics/index.js"
      },
      "./anim": {
        "types": "./dist/anim/index.d.ts",
        "import": "./dist/anim/index.js"
      },
      "./assets": {
        "types": "./dist/assets/index.d.ts",
        "import": "./dist/assets/index.js"
      },
      "./audio": {
        "types": "./dist/audio/index.d.ts",
        "import": "./dist/audio/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js"
      },
      "./fx": {
        "types": "./dist/fx/index.d.ts",
        "import": "./dist/fx/index.js"
      },
      "./geom": {
        "types": "./dist/geom/index.d.ts",
        "import": "./dist/geom/index.js"
      },
      "./host": {
        "types": "./dist/host/index.d.ts",
        "import": "./dist/host/index.js"
      },
      "./i18n": {
        "types": "./dist/i18n/index.d.ts",
        "import": "./dist/i18n/index.js"
      },
      "./input": {
        "types": "./dist/input/index.d.ts",
        "import": "./dist/input/index.js"
      },
      "./nav": {
        "types": "./dist/nav/index.d.ts",
        "import": "./dist/nav/index.js"
      },
      "./platform": {
        "types": "./dist/platform/index.d.ts",
        "import": "./dist/platform/index.js"
      },
      "./post": {
        "types": "./dist/post/index.d.ts",
        "import": "./dist/post/index.js"
      },
      "./render": {
        "types": "./dist/render/index.d.ts",
        "import": "./dist/render/index.js"
      },
      "./save": {
        "types": "./dist/save/index.d.ts",
        "import": "./dist/save/index.js"
      },
      "./tween": {
        "types": "./dist/tween/index.d.ts",
        "import": "./dist/tween/index.js"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "import": "./dist/ui/index.js"
      },
      "./voxel": {
        "types": "./dist/voxel/index.d.ts",
        "import": "./dist/voxel/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm check:docs && pnpm check:snippets && pnpm check:deprecated && pnpm check:api && pnpm test && pnpm check:host-electron && pnpm check:host-capacitor && pnpm check:host-pwa && pnpm check:template-puzzle && pnpm check:template-first-person && pnpm check:template-third-person && pnpm check:template-platformer && pnpm check:create-game && pnpm check:release && pnpm check:bake",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:snippets": "node scripts/check-snippets.mjs && node --test scripts/check-snippets.test.mjs",
    "check:deprecated": "node scripts/check-deprecated.mjs && node --test scripts/check-deprecated.test.mjs scripts/check-deprecated-game.test.mjs",
    "check:api": "node scripts/api-surface.mjs && node --test scripts/api-surface.test.mjs",
    "api:update": "node scripts/api-surface.mjs --update",
    "check:create-game": "node --test scripts/create-game.test.mjs",
    "check:release": "node --test scripts/release.test.mjs",
    "check:bake": "node --test scripts/bake.test.mjs scripts/bake-nav.test.mjs",
    "create-game": "node scripts/create-game.mjs",
    "bake": "node scripts/bake.mjs",
    "bake:nav": "node scripts/bake-nav.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "node scripts/refuse-publish.mjs",
    "build": "node scripts/build.mjs",
    "check:pack": "node scripts/pack-smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "test:e2e": "playwright test",
    "snap": "node scripts/snap.mjs --update",
    "snap:check": "node scripts/snap.mjs",
    "harness": "vite --config vite.harness.config.ts --host 127.0.0.1",
    "example": "vite examples/hello --host 127.0.0.1",
    "demo": "node scripts/demo.mjs",
    "check:host-electron": "pnpm --filter @thunderclap-engine/host-electron check",
    "check:host-capacitor": "pnpm --filter @thunderclap-engine/host-capacitor check",
    "check:template-puzzle": "pnpm --filter @thunderclap-engine/template-puzzle check",
    "template:puzzle": "pnpm --filter @thunderclap-engine/template-puzzle dev",
    "check:template-first-person": "pnpm --filter @thunderclap-engine/template-first-person check",
    "template:first-person": "pnpm --filter @thunderclap-engine/template-first-person dev",
    "desktop:dev": "pnpm --filter @thunderclap-engine/host-electron dev",
    "desktop:build": "pnpm --filter @thunderclap-engine/host-electron dist",
    "test:e2e:desktop": "pnpm --filter @thunderclap-engine/host-electron test:e2e",
    "check:host-pwa": "pnpm --filter @thunderclap-engine/host-pwa check",
    "pwa:dev": "pnpm --filter @thunderclap-engine/host-pwa dev",
    "pwa:build": "pnpm --filter @thunderclap-engine/host-pwa build",
    "check:template-third-person": "pnpm --filter @thunderclap-engine/template-third-person check",
    "template:third-person": "pnpm --filter @thunderclap-engine/template-third-person dev",
    "check:template-platformer": "pnpm --filter @thunderclap-engine/template-platformer check",
    "template:platformer": "pnpm --filter @thunderclap-engine/template-platformer dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  }
}
